<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup Rules (Legacy full-backup content for pre-API 31 devices).
   Strictly excludes vault directories, databases, and sensitive preferences.
-->
<full-backup-content>
    <!-- Exclude private encrypted files in internal storage -->
    <exclude domain="file" path="vault" />
    <exclude domain="file" path="backups" />

    <!-- Exclude databases -->
    <exclude domain="database" path="gallery_database" />
    <exclude domain="database" path="gallery_database-wal" />
    <exclude domain="database" path="gallery_database-shm" />

    <!-- Exclude account authentication preferences -->
    <exclude domain="sharedpref" path="vault_prefs.xml" />
    <exclude domain="sharedpref" path="app_settings_prefs.xml" />
</full-backup-content>
