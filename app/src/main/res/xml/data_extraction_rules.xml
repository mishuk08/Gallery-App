<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+) Data Extraction Rules.
   Strictly excludes private vault files, cryptographic databases, and account secrets
   from automated cloud backup and unauthenticated device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude private vault files -->
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="backups" />
        <!-- Exclude Room SQLite databases containing private media metadata -->
        <exclude domain="database" path="gallery_database" />
        <exclude domain="database" path="gallery_database-wal" />
        <exclude domain="database" path="gallery_database-shm" />
        <!-- Exclude preferences containing password hashes and salts -->
        <exclude domain="sharedpref" path="vault_prefs.xml" />
        <exclude domain="sharedpref" path="app_settings_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude private vault files and raw databases from device migration without user unlock -->
        <exclude domain="file" path="vault" />
        <exclude domain="file" path="backups" />
        <exclude domain="database" path="gallery_database" />
        <exclude domain="sharedpref" path="vault_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
